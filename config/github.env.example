# Template for the real config/github.env, which is created by
# `hermes-connect` (Milestone 2) on the target instance and is git-ignored.
# GitHub auth is expected to primarily use the `gh auth login` + HTTPS
# credential helper pattern (see SECURITY.md §3); this template covers
# what Hermes itself needs. Do not put a real token here — it is
# committed to Git.

GITHUB_TOKEN=REPLACE_ME
GITHUB_DEFAULT_ORG=REPLACE_ME

# Reference only — `hermes-connect` (Milestone 2, bootstrap/connect.sh)
# does NOT write to config/openai.env, and this file is never consumed by
# any script. OpenAI/Codex authentication is delegated entirely to the
# Hermes Agent CLI's own credential manager:
#
#   hermes auth add openai-codex --no-browser
#   hermes auth status openai-codex
#
# which persists OAuth/session state to $HERMES_HOME/auth.json (host:
# /opt/hermes-data/auth.json, git-ignored — see SECURITY.md §3). There is
# no env-var-based API key path in this design and no fake/mock provider
# fallback. This placeholder value is kept only so this file continues to
# document that OpenAI/Codex is one of the four connected integrations.

OPENAI_CODEX_PROVIDER=REPLACE_ME

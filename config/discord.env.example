# Reference only — `hermes-connect` (Milestone 2, bootstrap/connect.sh)
# does NOT write to config/discord.env. It writes these exact variable
# names directly into the official Hermes Agent persistence file,
# $HERMES_HOME/.env (host: /opt/hermes-data/.env, git-ignored — see
# SECURITY.md §3), which the Hermes Agent CLI loads automatically at
# startup. This file documents the variable names for reference; do not
# put a real token in this .example file — it is committed to Git.
#
# Names below match the real Discord platform plugin's declared env vars
# (plugins / platforms / discord / plugin.yaml in the pinned Hermes Agent
# source — see the pin file at bootstrap / hermes-commit.pin).

DISCORD_BOT_TOKEN=REPLACE_ME
# Comma-separated Discord snowflake IDs (15-20 digits). At least one of the
# three ALLOWED_* variables must be set — hermes-connect refuses to write
# an "allow all" configuration. DISCORD_ALLOW_ALL_USERS is always written
# as "false" by hermes-connect, never "true".
DISCORD_ALLOWED_USERS=REPLACE_ME
DISCORD_ALLOWED_ROLES=REPLACE_ME
DISCORD_ALLOWED_CHANNELS=REPLACE_ME
DISCORD_ALLOW_ALL_USERS=false

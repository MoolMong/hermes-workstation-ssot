# Reference only — `hermes-connect` (Milestone 2, bootstrap/connect.sh)
# does NOT write to config/claude.env, and this file is never consumed by
# any script. Claude Code authentication uses the Claude Code CLI's own
# persistent login (setup-token, or interactive /login), persisted under
# CLAUDE_CONFIG_DIR and HOME — both set to /data/auth/claude inside the
# Hermes Agent container (docker/Dockerfile), which is host:
# /opt/hermes-data/auth/claude (git-ignored — see SECURITY.md §3). This
# placeholder value is kept only so this file continues to document that
# Claude Code is one of the four connected integrations.

CLAUDE_CODE_INTEGRATION=REPLACE_ME
